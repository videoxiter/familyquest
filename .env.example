# Скопируй этот файл в .env.local и подставь свои значения.
# Взять: Supabase → Project Settings → API
#   Project URL        -> VITE_SUPABASE_URL
#   anon / public key  -> VITE_SUPABASE_ANON_KEY
#
# anon-ключ публичен по замыслу (он попадает в JS-бандл), доступ к данным
# закрывают RLS-политики. service_role в браузере НЕ используется никогда.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Публичный VAPID-ключ для web-push. Сгенерировать пару: npm run vapid
# (ключи появятся в .secrets/vapid.json). Публичный можно коммитить,
# приватный — только в Supabase → Edge Functions → Secrets.
VITE_VAPID_PUBLIC_KEY=
